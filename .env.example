# Private key of the deployer (without 0x prefix)
PRIVATE_KEY=your_private_key_here

# RPC URLs
SEPOLIA_RPC_URL=https://rpc.sepolia.org
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545

# Etherscan / BscScan API key for contract verification (optional)
ETHERSCAN_API_KEY=your_etherscan_api_key
BSCSCAN_API_KEY=your_bscscan_api_key

# Admin address (defaults to deployer if not set)
ADMIN_ADDRESS=

# Initial token address (USDT on respective testnet; leave empty for mock deployment)
TOKEN_ADDRESS=
